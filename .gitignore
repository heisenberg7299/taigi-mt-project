venv/
venv_meralion/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# 大型/可重新產生的檔案，不進版控
models/
data/raw/*
tests/audio/
tests/tts_benchmark_audio/
# ChhoeTaigi詞庫下載說明是操作指南，不是資料本身，例外要進版控；
# 目錄底下的CSV(下載後91,339列)仍要忽略，只有README例外
!data/raw/chhoetaigi_taihoa_dict/
data/raw/chhoetaigi_taihoa_dict/*
!data/raw/chhoetaigi_taihoa_dict/README.md

# 測試者的即時回覆資料（個人意見、持續累積），不進版控
data/human_review/
data/processed/
reports/feedback_summary.md
reports/errors.csv

# Ollama / TTS 本機執行期產生的檔案
*.wav
# docs/audio/ 是驗證平台(GitHub Pages)要發布的靜態音檔，例外要進版控
!docs/audio/*.wav
# voice cloning用的參考語音，是adapter程式碼會讀取的固定資源，例外要進版控
!tests/voice_refs/*.wav
# Response Controller安全檢查失敗時的固定回覆音檔，是程式碼依賴的固定資源，例外要進版控
!assistant_service/fallback_audio/*.wav

# cloudflared tunnel 執行期產生的檔案（網址每次重啟會變，不該寫死進版控）
CURRENT_TUNNEL_URL.txt
cloudflared.log
tunnel_watchdog.log
CURRENT_TUNNEL_URL_ASSISTANT_WEB.txt
cloudflared_assistant_web.log
tunnel_watchdog_assistant_web.log

# live_test平台(scripts/start_live_test.sh)執行期產生的log
live_test_neurlang.log
live_test_meralion.log
live_test_gateway.log

# tw_hokkien_tts_pipeline CLI/測試執行期產生的輸出(wav+debug json)
pipeline_output/

# multilingual_output.py的gTTS中英文補充語音快取(執行期產生，mp3不是*.wav
# 涵蓋得到，另外排除；不是安全驗證過的固定資源，不需要例外)
assistant_service/cache/multilingual_audio/
